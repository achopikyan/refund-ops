# Copy to .env and add one provider key. Do not commit .env.
# Leave AI_PROVIDER empty to choose OpenAI, or OpenRouter when only its key is set.
# Without a key, the bundled demo can reuse its recorded live OpenRouter analysis.
# New or edited requests need a configured provider and fresh LLM analysis.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6.1-sol
# Soft threshold over reported cost, not a billing cap. Use provider account limits.
# OpenAI reports tokens but no per-call dollar cost; that cost remains unknown.
LLM_RUN_BUDGET_USD=2.00
